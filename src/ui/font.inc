struct AccM { int cp; char base, kind; };   // kind: a agudo, g grave, c circunflexo, t til, z cedilha
static const AccM ACC[] = {{0xE1,'a','a'},{0xE0,'a','g'},{0xE2,'a','c'},{0xE3,'a','t'},{0xE9,'e','a'},{0xE8,'e','g'},{0xEA,'e','c'},{0xED,'i','a'},{0xF3,'o','a'},{0xF4,'o','c'},{0xF5,'o','t'},{0xFA,'u','a'},{0xE7,'c','z'},
    {0xC1,'A','a'},{0xC0,'A','g'},{0xC2,'A','c'},{0xC3,'A','t'},{0xC9,'E','a'},{0xCA,'E','c'},{0xCD,'I','a'},{0xD3,'O','a'},{0xD4,'O','c'},{0xD5,'O','t'},{0xDA,'U','a'},{0xC7,'C','z'}};
static int u8next(const char*& s) {   // próximo ponto de código UTF-8
    unsigned char c = (unsigned char)*s++;
    if (c < 0x80) return c;
    if ((c & 0xE0) == 0xC0 && ((unsigned char)*s & 0xC0) == 0x80) { int r = ((c & 0x1F) << 6) | ((unsigned char)*s & 0x3F); s++; return r; }
    while (((unsigned char)*s & 0xC0) == 0x80) s++;
    return '?';
}
static std::string foldAscii(const char* s) {   // minúsculas sem acento (busca e comandos)
    std::string o;
    for (const char* p = s; *p;) { int cp = u8next(p); char ch = 0; if (cp < 128) ch = (char)tolower(cp); else for (const AccM& a : ACC) if (a.cp == cp) ch = (char)tolower(a.base); if (ch) o += ch; }
    return o;
}
// Fonte proporcional (como a do Minecraft): cada glifo ocupa so as colunas usadas + 1 pixel de espaco; espaco = 4.
static void glyphMetrics(int cp, int& first, int& adv) {
    if (cp == ' ') { first = 0; adv = 4; return; }
    int base = cp;
    if (cp >= 128) { base = '?'; for (const AccM& a : ACC) if (a.cp == cp) { base = a.base; break; } }
    if (base < 32 || base > 126) base = '?';
    const uint8_t* g = F57[base - 32]; int lo = 5, hi = -1;
    for (int c = 0; c < 5; c++) if (g[c]) { if (c < lo) lo = c; hi = c; }
    if (hi < 0) { first = 0; adv = 4; return; }
    first = lo; adv = hi - lo + 2;
}
static float textWidth(const char* s, float sc) { int n = 0; for (const char* p = s; *p;) { int f, a; glyphMetrics(u8next(p), f, a); n += a; } return n ? (n - 1) * sc : 0.f; }
#ifndef GL_CLIENT_VERTEX_ARRAY_BIT
#define GL_CLIENT_VERTEX_ARRAY_BIT 0x2
#endif
#ifndef GL_NORMAL_ARRAY
#define GL_NORMAL_ARRAY 0x8075
#endif
#ifndef GL_ARRAY_BUFFER_BINDING
#define GL_ARRAY_BUFFER_BINDING 0x8894
#endif
static std::vector<float>* gGlyphBuf = nullptr;   // patchRpiPerf.2: se != null, glyphQuads grava os vertices aqui em vez de chamar glVertex2f
static void glyphQuads(int cp, float ox, float oy, float sc) {   // só glVertex: chamado dentro de glBegin
    int ch = cp; char kind = 0;
    if (cp < 32 || cp > 126) { ch = '?'; for (const AccM& a : ACC) if (a.cp == cp) { ch = a.base; kind = a.kind; } }
    const uint8_t* g = F57[ch - 32];
    const bool up = ch >= 'A' && ch <= 'Z';
    auto R = [&](int cx, int cy, int w, int h) {
        float X0 = floorf(ox + cx * sc + .5f), X1 = floorf(ox + (cx + w) * sc + .5f), Y0 = floorf(oy + cy * sc + .5f), Y1 = floorf(oy + (cy + h) * sc + .5f);
        if (gGlyphBuf) { const float q[8] = {X0, Y0, X1, Y0, X1, Y1, X0, Y1}; gGlyphBuf->insert(gGlyphBuf->end(), q, q + 8); return; }
        glVertex2f(X0, Y0); glVertex2f(X1, Y0); glVertex2f(X1, Y1); glVertex2f(X0, Y1);
    };
    for (int c = 0; c < 5; c++) {
        int bits = g[c]; if (kind && ch == 'i') bits &= ~3;   // í perde o pingo
        for (int r = 0; r < 8;) { if ((bits >> r) & 1) { int r2 = r; while (r2 < 8 && ((bits >> r2) & 1)) r2++; R(c, r, 1, r2 - r); r = r2; } else r++; }
    }
    const int t = up ? -2 : 0;
    switch (kind) {
        case 'a': R(3, t, 1, 1); R(2, t + 1, 1, 1); break;
        case 'g': R(1, t, 1, 1); R(2, t + 1, 1, 1); break;
        case 'c': R(2, t, 1, 1); R(1, t + 1, 1, 1); R(3, t + 1, 1, 1); break;
        case 't': R(1, t + 1, 1, 1); R(2, t, 1, 1); R(3, t + 1, 1, 1); R(4, t, 1, 1); break;
        case 'z': R(2, 7, 1, 1); R(1, 8, 1, 1); break;
        default: break;
    }
}
// sc = pixels por pixel da fonte (inteiro). sh = deslocamento da sombra (0 = sem sombra, <0 = sc). a = opacidade.
static void text(float x, float y, float sc, const char* s, float r, float g, float b, float sh = -1, float a = 1.f) {
    if (sh < 0) sh = sc;
#if defined(BL_RPI) && !defined(__ANDROID__) && !defined(BL_VULKAN)
    {   // patchRpiPerf.2: a string vira UM glDrawArrays por passada (antes: centenas de glVertex2f; cada glifo tem varios retangulos)
        static std::vector<float> buf, sb; buf.clear(); gGlyphBuf = &buf; float gx = x;
        for (const char* p = s; *p;) { int cp = u8next(p), gf, ga; glyphMetrics(cp, gf, ga); glyphQuads(cp, gx - gf * sc, y, sc); gx += ga * sc; }
        gGlyphBuf = nullptr;
        if (buf.empty()) return;
        rdDisable(GL_TEXTURE_2D);
        glPushClientAttrib(GL_CLIENT_VERTEX_ARRAY_BIT); glDisableClientState(GL_COLOR_ARRAY); glDisableClientState(GL_TEXTURE_COORD_ARRAY); glDisableClientState(GL_NORMAL_ARRAY); glEnableClientState(GL_VERTEX_ARRAY);
        { GLint ab = 0; glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &ab); if (ab) { static PFNGLBINDBUFFERPROC bb = (PFNGLBINDBUFFERPROC)SDL_GL_GetProcAddress("glBindBuffer"); if (bb) bb(GL_ARRAY_BUFFER, 0); } }
        if (sh != 0) { sb = buf; for (size_t i = 0; i < sb.size(); i++) sb[i] += sh; glColor4f(r * .25f, g * .25f, b * .25f, a); glVertexPointer(2, GL_FLOAT, 0, sb.data()); glDrawArrays(GL_QUADS, 0, (GLsizei)(sb.size() / 2)); }
        glColor4f(r, g, b, a); glVertexPointer(2, GL_FLOAT, 0, buf.data()); glDrawArrays(GL_QUADS, 0, (GLsizei)(buf.size() / 2));
        glPopClientAttrib(); rdEnable(GL_TEXTURE_2D);
        return;
    }
#endif
    rdDisable(GL_TEXTURE_2D);
    for (int pass = 0; pass < 2; pass++) {
        if (pass == 0) { if (sh == 0) continue; glColor4f(r * .25f, g * .25f, b * .25f, a); } else glColor4f(r, g, b, a);
        float cx = x + (pass == 0 ? sh : 0), cy = y + (pass == 0 ? sh : 0);
        glBegin(GL_QUADS);
        for (const char* p = s; *p;) { int cp = u8next(p), gf, ga; glyphMetrics(cp, gf, ga); glyphQuads(cp, cx - gf * sc, cy, sc); cx += ga * sc; }
        glEnd();
    }
    rdEnable(GL_TEXTURE_2D);
}
