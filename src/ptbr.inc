static void ptbrApply() {
    static std::unordered_map<std::string, const char*> m; if (m.empty()) for (const PtName& p : PT_NAMES) m[p.en] = p.pt;
    for (PkItem& e : PK) { auto it = m.find(e.name); if (it != m.end()) { e.name = it->second; e.fold = foldAscii(it->second); } }
